# Signatures for rbagent's public surface.
#
# Everything that crosses a Ractor boundary is JSON, so most types here are
# `Hash[String, untyped]` on purpose: that *is* the type. The value of writing
# them down is the shape of the API — what returns a result hash, what returns
# an entry, what can be nil — and `rake rbs` keeps them honest.

module Durable
  VERSION: String

  class RemoteError < StandardError
  end

  # ── ipc ────────────────────────────────────────────────────────────────
  module IPC
    DEFER: Symbol

    def self.encode: (untyped) -> String
    def self.decode: (String?) -> untyped
    def self.reply_port: () -> Ractor::Port
    def self.post: (Ractor | Ractor::Port, untyped) -> nil
    def self.cast: (Ractor | Ractor::Port, String | Symbol, ?untyped) -> nil
    def self.call: (Ractor | Ractor::Port, String | Symbol, ?untyped, ?port: Ractor::Port) -> untyped
    def self.reply: (Ractor::Port?, untyped) -> nil
    def self.serve: (untyped) { (String, untyped, Ractor::Port?) -> untyped } -> void
  end

  module Ids
    def self.entry: () -> String
    def self.record: () -> String
    def self.session: () -> String
    def self.step: () -> String
    def self.now_ms: () -> Integer
  end

  # ── storage and session ────────────────────────────────────────────────
  module Storage
    class Corrupt < StandardError
    end

    class Base
      FORMAT_VERSION: Integer

      attr_reader metadata: Hash[String, untyped]

      def initialize: (?metadata: Hash[String, untyped]) -> void
      def append_entry: (Hash[String, untyped], String) -> Hash[String, untyped]
      def append_record: (Hash[String, untyped], ?move_lane: Hash[String, untyped]?) -> Hash[String, untyped]
      def create_entry_id: () -> String
      def lanes: () -> Array[Hash[String, untyped]]
      def create_lane: (String, String?) -> nil
      def delete_lane: (String) -> nil
      def move_lane: (String, String?) -> nil
      def set_name: (String) -> nil
      def name: () -> String?
      def set_label: (String, String?) -> nil
      def label: (String) -> String?
      def entry: (String) -> Hash[String, untyped]?
      def find_entries: (?Hash[untyped, untyped]) -> Array[Hash[String, untyped]]
      def find_entries_on_branch: (?Hash[untyped, untyped]) -> Array[Hash[String, untyped]]
      def find_records: (?Hash[untyped, untyped]) -> Array[Hash[String, untyped]]
      def log: (?after_seq: Integer?, ?limit: Integer?) -> Array[Hash[String, untyped]]
      def stats: () -> Hash[String, untyped]
    end

    class Memory < Base
      def self.open: (?String?, ?metadata: Hash[String, untyped]) -> Memory
    end

    class Jsonl < Base
      attr_reader path: String

      def self.open: (String, ?metadata: Hash[String, untyped]) -> Jsonl
      def close: () -> void
    end
  end

  module Store
    def self.spawn: (?kind: String, ?path: String?, ?metadata: Hash[String, untyped]) -> Ractor
  end

  class Session
    attr_reader lane: String
    attr_reader store: Ractor

    def initialize: (Ractor, ?lane: String) -> void
    def view: (String) -> Session
    def leaf_id: () -> String?
    def entry: (String) -> Hash[String, untyped]?
    def find_entries: (?Hash[untyped, untyped]) -> Array[Hash[String, untyped]]
    def find_entry: (?Hash[untyped, untyped]) -> Hash[String, untyped]?
    def find_entries_on_branch: (?Hash[untyped, untyped]) -> Array[Hash[String, untyped]]
    def find_entry_on_branch: (?Hash[untyped, untyped]) -> Hash[String, untyped]?
    def path_entries: (?start: String?) -> Array[Hash[String, untyped]]
    def context_entries: (?start: String?) -> Array[Hash[String, untyped]]
    def append_entry: (Hash[String, untyped]) -> Hash[String, untyped]
    def append_message: (Hash[String, untyped]) -> Hash[String, untyped]
    def append_custom_entry: (String, ?untyped) -> Hash[String, untyped]
    def append_if_missing: (Hash[String, untyped]) -> Hash[String, untyped]
    def create_entry_id: () -> String
    def lanes: () -> Array[Hash[String, untyped]]
    def append_record: (Hash[String, untyped], ?move_lane: Hash[String, untyped]?) -> Hash[String, untyped]
    def find_records: (?Hash[untyped, untyped]) -> Array[Hash[String, untyped]]
    def close: () -> untyped
  end

  # ── tools ──────────────────────────────────────────────────────────────
  module Tools
    MAX_OUTPUT: Integer
    MAX_OUTPUT_LINES: Integer
    LOG_DIR: String

    def self.names: () -> Array[String]
    def self.spec: (String) -> Hash[String, untyped]?
    def self.replay_of: (String) -> String
    def self.declarations: (?Array[String]?) -> Array[Hash[String, untyped]]
    def self.spawn: (String, Hash[String, untyped], String) -> Ractor
    def self.cancel: (Ractor) -> void
    def self.invoke: (String, Hash[String, untyped], String, ?(^() -> bool)?) -> Hash[String, untyped]
    def self.validate: (String, Hash[String, untyped]) -> String?
    def self.ok: (untyped, ?details: Hash[String, untyped]?) -> Hash[String, untyped]
    def self.error: (untyped, ?details: Hash[String, untyped]?) -> Hash[String, untyped]
    def self.overspill: (String, String) -> [String, Hash[String, untyped]?]
    def self.clip: (String) -> String
    def self.exec_stream: (String, String, ?timeout: Float, ?cancel: (^() -> bool)?) ?{ (String) -> void } -> Hash[String, untyped]
  end

  # ── typed tools ────────────────────────────────────────────────────────
  module RbsSchema
    SIGNATURE_MARKERS: Array[String]
    SEARCH_LIMIT: Integer

    def self.rbs_available?: () -> bool
    def self.comment_block: (String?, Integer?) -> Hash[String, untyped]
    def self.parse_comments: (Array[String]) -> Hash[String, untyped]
    def self.proc_signature: (Proc) -> Hash[String, untyped]
    def self.to_schema: (String?, ?params: Hash[String, String], ?parameters: Array[untyped]?) -> Hash[String, untyped]
    def self.parse: (String) -> Hash[String, Hash[Symbol, untyped]]
    def self.json_type: (untyped) -> Hash[String, untyped]
  end

  module ToolDSL
    class Definition
      attr_reader name: String
      attr_reader handler: Proc?

      def initialize: (String | Symbol) -> void
      def description: (?String?) -> String
      def replay: (String | Symbol) -> String
      def sandbox: (?bool) -> bool
      def sandboxed?: () -> bool
      def run: () { (*untyped) -> untyped } -> Proc
      def keywords?: () -> bool
      def declaration: () -> Hash[String, untyped]
    end

    class Context
      attr_reader sandbox: Sandbox::Client?
      attr_reader cwd: String
      attr_reader lane: String

      def sh: (String, ?timeout: Integer) -> String
      def read: (String) -> String
      def write: (String, String) -> untyped
    end

    def self.load_dir: (String) -> Hash[String, untyped]
    def self.invoke: (Definition, Hash[String, untyped], Context) -> Hash[String, untyped]
  end

  # ── project ────────────────────────────────────────────────────────────
  class Project
    attr_reader root: String
    attr_reader instructions: String?
    attr_reader config: Hash[String, untyped]
    attr_reader tools: Array[ToolDSL::Definition]
    attr_reader skills: Array[Hash[String, untyped]]
    attr_reader diagnostics: Array[Hash[String, untyped]]
    attr_reader sandbox_config: Hash[String, untyped]
    attr_reader prompt_sources: Array[Hash[String, untyped]]

    def self.load: (?String, ?user_skills: bool) -> Project
    def self.agent_dir?: (?String) -> bool
    def self.init: (?String, ?name: String?, ?force: bool) -> Hash[String, untyped]
    def initialize: (?String, ?user_skills: bool) -> void
    def agent?: () -> bool
    def name: () -> String
    def sessions_dir: () -> String
    def tool: (String) -> ToolDSL::Definition?
    def tool_declarations: () -> Array[Hash[String, untyped]]
    def system_prompt: (?tools: Array[String]?, ?sandbox: Sandbox::Client?) -> String
  end

  # ── sandbox ────────────────────────────────────────────────────────────
  module Sandbox
    DEFAULTS: Hash[String, untyped]
    APT_PACKAGES: Array[String]
    MISE_TOOLS: Array[String]

    def self.config: (?Hash[untyped, untyped]?) -> Hash[String, untyped]
    def self.resolve: (Hash[untyped, untyped], ?warn_io: IO?) -> Client
    def self.load_definition: (String) -> Hash[String, untyped]
    def self.create_options: (Hash[String, untyped], String, String) -> Hash[String, untyped]
    def self.network_options: (Hash[String, untyped]) -> Hash[String, untyped]
    def self.secret_entries: (Hash[String, untyped]) -> Array[Hash[String, untyped]]
    def self.provision_script: (Hash[String, untyped]) -> String

    class Client
      attr_reader config: Hash[String, untyped]
      attr_reader backend_name: String

      def isolated?: () -> bool
      def start: () -> Client
      def exec: (String, ?timeout: Integer, ?cancel: (^() -> bool)?) -> Hash[String, untyped]
      def read_file: (String) -> String
      def write_file: (String, String) -> untyped
      def stop: () -> void
      def describe: () -> String
    end

    module HostAuth
      GITHUB_HOSTS: Array[String]

      def self.github_token: () -> Hash[String, String]?
      def self.github_secret: (?placeholder: String) -> Hash[String, untyped]?
    end

    class Microsandbox
      class Error < StandardError
        attr_reader kind: String
      end

      class NotAvailable < Error
      end

      def self.library_path: () -> String?
      def self.available?: () -> bool
      def initialize: (?path: String?) -> void
      def version: () -> Hash[String, untyped]
      def call: (String, *untyped, ?buffer_only: bool, ?cancel: (^() -> bool)?) -> Hash[String, untyped]
      def create: (String, ?Hash[String, untyped]) -> Hash[String, untyped]
      def connect: (String) -> Hash[String, untyped]
      def exec: (String, ?args: Array[String], ?cwd: String?, ?timeout: Integer?, ?cancel: (^() -> bool)?) -> Hash[String, untyped]
      def read_file: (String) -> String
      def write_file: (String, String) -> untyped
      def stop: (?timeout_ms: Integer) -> untyped
    end
  end

  # ── harness ────────────────────────────────────────────────────────────
  class Harness
    HOOKS: Array[String]

    attr_reader store: Ractor
    attr_reader hub: Ractor
    attr_reader session: Session
    attr_reader config: Hash[String, untyped]
    attr_reader suspended: Array[Hash[String, untyped]]

    def self.create: (**untyped) -> [Harness, Array[Hash[String, untyped]]]
    def lane: (String) -> LaneHandle?
    def main: () -> LaneHandle
    def lanes: () -> Array[Hash[String, untyped]]
    def create_lane: (String, String?) -> Hash[String, untyped]
    def delete_lane: (String) -> Hash[String, untyped]
    def prompt: (?String?, ?message: Hash[String, untyped]?, ?content: Array[untyped]?) -> Hash[String, untyped]
    def steer: (String) -> Hash[String, untyped]
    def follow_up: (String) -> Hash[String, untyped]
    def next_run: (String) -> Hash[String, untyped]
    def abort!: (?String) -> Hash[String, untyped]
    def resume: () -> Hash[String, untyped]
    def compact: (?custom_instructions: String?) -> Hash[String, untyped]
    def navigate: (String, ?summarize: bool, ?label: String?, ?custom_instructions: String?) -> Hash[String, untyped]
    def state: () -> Hash[String, untyped]
    def goal: () -> String?
    def set_goal: (String) -> Hash[String, untyped]
    def run_skill: (String, ?String?) -> Hash[String, untyped]
    def on_hook: (String | Symbol) { (Hash[String, untyped]) -> untyped } -> ^() -> untyped
    def on_event: () { (Hash[String, untyped]) -> void } -> ^() -> untyped
    def watch: (?String?) -> Watch
    def watch_session: () -> Watch
    def model: () -> Hash[String, untyped]
    def set_model: (String | Hash[String, untyped]) -> Hash[String, untyped]
    def available_models: () -> Array[Hash[String, untyped]]
    def agents_md: () -> Array[Hash[String, untyped]]
    def skills: () -> Array[Hash[String, untyped]]
    def skill_diagnostics: () -> Array[Hash[String, untyped]]
    def project: () -> Project?
    def sandbox: () -> Sandbox::Client?
    def project_tools: () -> Array[ToolDSL::Definition]
    def system_prompt: () -> String
    def close: () -> void

    class LaneHandle
      attr_reader name: String

      def state: () -> Hash[String, untyped]
      def leaf_id: () -> String?
      def prompt: (?String?, ?message: Hash[String, untyped]?, ?content: Array[untyped]?) -> Hash[String, untyped]
      def skill: (String, ?String?) -> Hash[String, untyped]
      def goal: () -> String?
      def set_goal: (String) -> Hash[String, untyped]
      def append_bash: (String, String, Integer) -> Hash[String, untyped]
      def steer: (String) -> Hash[String, untyped]
      def follow_up: (String) -> Hash[String, untyped]
      def next_run: (String) -> Hash[String, untyped]
      def abort!: (?String) -> Hash[String, untyped]
      def resume: () -> Hash[String, untyped]
      def compact: (?custom_instructions: String?) -> Hash[String, untyped]
      def navigate: (String, ?summarize: bool, ?label: String?, ?custom_instructions: String?) -> Hash[String, untyped]
      def set_persisted: (String, untyped) -> Hash[String, untyped]
      def update_runtime: (Hash[String, untyped]) -> Hash[String, untyped]
      def wait_idle: () -> Hash[String, untyped]
      def session: () -> Session
      def close: () -> untyped
    end
  end

  class Watch
    attr_reader snapshot: Hash[String, untyped]
    attr_reader port: Ractor::Port

    def initialize: (Ractor, ?lane: String?) -> void
    def each_event: () { (Hash[String, untyped]) -> void } -> void
    def next_event: () -> Hash[String, untyped]?
    def close: () -> nil
  end
end
