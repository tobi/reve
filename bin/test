#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs every test file in its own process (Ractors and crash injection do not
# survive being mixed into one interpreter).
root = File.expand_path("..", __dir__)
files = Dir.glob(File.join(root, "test", "test_*.rb")).sort
failed = []
timeout = Integer(ENV.fetch("TEST_TIMEOUT", "60"))
files.each do |f|
  puts "\n\e[1m#{File.basename(f)}\e[0m"
  $stdout.flush
  # Each suite owns a process group. If it exceeds the deadline, kill the whole
  # group — not merely the `timeout` wrapper — so no Ruby, sleep, compiler, or
  # sandbox child can survive and poison the next run.
  pid = Process.spawn(RbConfig.ruby, f, pgroup: true)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
  status = nil
  until status
    _, status = Process.waitpid2(pid, Process::WNOHANG)
    break if status

    if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
      warn "\e[31mTIMEOUT after #{timeout}s: #{File.basename(f)}\e[0m"
      Process.kill("TERM", -pid) rescue nil
      sleep 0.2
      Process.kill("KILL", -pid) rescue nil
      _, status = Process.waitpid2(pid) rescue [nil, nil]
      break
    end
    sleep 0.02
  end
  failed << f unless status&.success?
end
puts
if failed.empty?
  puts "\e[32mall suites passed\e[0m"
else
  puts "\e[31mfailed: #{failed.map { File.basename(_1) }.join(", ")}\e[0m"
  exit 1
end
