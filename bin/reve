#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/reve"
require_relative "../lib/reve/tui"

# `reve init` scaffolds an agent directory, eve-style: instructions.md is all
# you need, the rest are optional building blocks.
if ARGV.first == "init"
  ARGV.shift
  target = ARGV.shift || Dir.pwd
  force = !ARGV.delete("--force").nil?
  result = Reve::Project.init(target, force: force)

  if !force && !result["updateCandidates"].empty?
    approved = []
    if $stdin.tty? && $stdout.tty?
      puts "\e[1mchanged scaffold files\e[0m"
      result["updateCandidates"].each do |rel|
        print "  update \e[33m#{rel}\e[0m to the current template? [y/N] "
        answer = $stdin.gets.to_s.strip.downcase
        approved << rel if %w[y yes].include?(answer)
      end
      unless approved.empty?
        applied = Reve::Project.init(target, update: approved)
        result["updated"] = applied["updated"]
      end
    end
  end

  puts "\e[1minitialised #{result["root"]}\e[0m"
  result["created"].each { puts "  \e[32m+\e[0m #{_1}" }
  result["updated"].each { puts "  \e[33m↑\e[0m #{_1} (updated)" }
  result["unchanged"].each { puts "  \e[2m· #{_1} (unchanged)\e[0m" }
  kept = result["updateCandidates"] - result["updated"]
  kept.each { puts "  \e[2m· #{_1} (changed; kept)\e[0m" }
  if !kept.empty? && !($stdin.tty? && $stdout.tty?)
    puts "  run \e[1mreve init #{target} --force\e[0m to update changed scaffold files"
  end
  puts
  puts "  edit \e[1minstructions.md\e[0m, then run \e[1mreve\e[0m in this directory"
  exit 0
end

# `agent.rb` is an executable launcher (`#!/usr/bin/env reve`). The kernel
# passes its path as argv[0]; consume that marker instead of sending it to the
# model as a prompt, and locate the agent even when invoked from elsewhere.
launcher = ARGV.first && File.expand_path(ARGV.first)
if launcher && File.basename(launcher) == "agent.rb" && File.file?(launcher) &&
   File.open(launcher) { _1.gets.to_s }.strip == "#!/usr/bin/env reve"
  ARGV.shift
  launcher_root = File.dirname(launcher)
end

options = {
  storage: "jsonl",
  model: "openai/gpt-5.6-luna",
  cwd: launcher_root || Dir.pwd,
  resume: false,
  conversation: "main",
  print: nil,
  session: nil
}

OptionParser.new do |o|
  o.banner = "usage: reve [options] [prompt]\n       reve init [dir]   scaffold an agent directory"
  o.on("-m", "--model SPEC", "provider, provider/model-id, or model-id (default #{options[:model]})") do
    options[:model] = _1
    options[:model_given] = true
  end
  o.on("-s", "--session PATH", "session file (JSONL)") { options[:session] = _1 }
  o.on("-c", "--conversation NAME", "open a named conversation (default main)") do |name|
    options[:conversation] = name
  end
  o.on("-r", "--resume", "immediately resume a suspended operation") { options[:resume] = true }
  o.on("-p", "--print PROMPT", "run one prompt non-interactively and exit") { options[:print] = _1 }
  o.on("--memory", "keep the session in memory only") { options[:storage] = "memory" }
  o.on("--list", "list sessions for this directory") { options[:list] = true }
  o.on("-v", "--version", "print the version") do
    puts "reve #{Reve::VERSION}"
    exit 0
  end
  o.on("-h", "--help") do
    puts o
    exit 0
  end
end.parse!

prompt_arg = ARGV.join(" ") unless ARGV.empty?

# reve runs *an agent*, and an agent is a directory. Without one there is
# nothing to run, so say what is missing and how to make it rather than starting
# a personality-free chat session in someone's checkout.
unless Reve::Project.agent_dir?(options[:cwd])
  warn "\e[1mnot an agent directory\e[0m: #{options[:cwd]}"
  warn ""
  warn "  an agent needs at least one of:"
  warn "    instructions.md   what the agent is and how it works"
  warn "    agent.rb          its configuration (model, tools, sandbox)"
  warn ""
  warn "  \e[1mreve init\e[0m           scaffold one here"
  exit 1
end

PROJECT = Reve::Project.load(options[:cwd])
dir = PROJECT.sessions_dir
FileUtils.mkdir_p(dir)

if options[:list]
  Dir.glob(File.join(dir, "*.jsonl")).sort.reverse.each do |f|
    puts "#{File.mtime(f).strftime("%Y-%m-%d %H:%M")}  #{File.size(f).to_s.rjust(8)}  #{f}"
  end
  exit 0
end

path =
  if options[:session]
    candidate = File.expand_path(options[:session], dir)
    unless candidate.start_with?("#{File.expand_path(dir)}/")
      warn "session must be inside #{dir}"
      exit 1
    end
    candidate
  else
    PROJECT.conversation_path(options[:conversation])
  end

build_harness = nil
build_harness = lambda do |session_path, sandbox = nil|
  h, suspended_ops = Reve::Harness.create(
    storage: options[:storage], path: options[:storage] == "jsonl" ? session_path : nil,
    model: options[:model_given] ? options[:model] : (PROJECT.config["model"] || options[:model]),
    cwd: options[:cwd], project: PROJECT, sandbox: sandbox,
    conversation: options[:conversation]
  )
  h.on_hook("before_tool") do |ev|
    target = ev.dig("args", "path")
    if %w[write edit].include?(ev["toolName"]) && target &&
       !File.expand_path(target).start_with?(options[:cwd]) && !ENV["REVE_ALLOW_OUTSIDE"]
      { "block" => { "reason" => "path is outside the workspace (#{options[:cwd]}); " \
                                 "set REVE_ALLOW_OUTSIDE=1 to permit" } }
    end
  end
  h.new_session_factory = lambda do |current|
    fresh_path = PROJECT.conversation_path(options[:conversation], fresh: true)
    build_harness.call(fresh_path, current.sandbox)
  end
  h.start_heartbeat if options[:conversation] == "main" && options[:print].nil? && prompt_arg.nil?
  [h, suspended_ops]
end

harness, suspended = begin
  build_harness.call(path)
rescue Reve::Sandbox::Unavailable => e
  warn "reve requires microsandbox-rb and a working microVM runtime: #{e.message}"
  warn "run `bundle install`, then verify KVM (Linux) or Apple virtualization support (macOS)"
  exit 1
end

one_shot = options[:print] || prompt_arg

# Resume-only: no prompt, just finish what the dead process started.
if one_shot.nil? && options[:resume] && !$stdout.tty?
  Thread.new do
    w = harness.watch(nil)
    w.each_event do |ev|
      d = ev["event"]
      print d["text"] if ev["type"] == "message_update" && d && d["type"] == "text_delta"
      warn "  → #{ev["toolName"]}" if ev["type"] == "tool_start"
      $stdout.flush
    end
  rescue Ractor::ClosedError
    nil
  end
  if suspended.empty?
    warn "nothing to resume"
  else
    suspended.each { |s| warn "· resuming #{s["kind"]} on #{s["lane"]} (#{s["reason"]})" }
    results = suspended.map { |s| harness.lane(s["lane"]).resume }
    puts
    results.each { |r| warn "· #{r["ok"] ? "completed" : r["outcome"]}" }
  end
  harness.close
  exit 0
end

if one_shot
  # Non-interactive: stream to stdout, exit with the run's outcome.
  Thread.new do
    w = harness.watch(nil)
    w.each_event do |ev|
      case ev["type"]
      when "message_update"
        d = ev["event"]
        print d["text"] if d && d["type"] == "text_delta"
      when "tool_start" then warn "  → #{ev["toolName"]} #{ev["args"].inspect[0, 120]}"
      end
      $stdout.flush
    end
  rescue Ractor::ClosedError
    nil
  end
  suspended.each { |s| harness.lane(s["lane"]).resume } if options[:resume]
  result = harness.prompt(one_shot)
  puts
  warn "· #{result["ok"] ? "completed" : result["outcome"]}"
  harness.close
  exit(result["ok"] ? 0 : 1)
end

channel_file = File.join(PROJECT.root, "channels", "tui.rb")
load channel_file if File.file?(channel_file)
channel = if defined?(Reve::Channels::TUI)
            Reve::Channels::TUI.new(harness, suspended)
          else
            Reve::InteractiveAgentTUI.new(harness, suspended)
          end
if options[:resume]
  suspended.each { |s| Thread.new { harness.lane(s["lane"]).resume } }
end
channel.run
